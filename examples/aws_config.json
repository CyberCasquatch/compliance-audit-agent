{
  "account_id": "123456789012",
  "region": "us-east-1",
  "snapshot_date": "2024-01-15",

  "iam": {
    "root_mfa_enabled": false,
    "root_access_keys_exist": false,
    "password_policy": {
      "minimum_password_length": 8,
      "require_uppercase": false,
      "require_lowercase": false,
      "require_symbols": false,
      "require_numbers": false,
      "max_password_age_days": 0,
      "password_reuse_prevention": 0
    },
    "users": [
      { "username": "admin", "mfa_enabled": true, "access_key_age_days": 45 },
      { "username": "deploy-svc", "mfa_enabled": false, "access_key_age_days": 210 },
      { "username": "alice", "mfa_enabled": false, "access_key_age_days": 180 },
      { "username": "bob", "mfa_enabled": true, "access_key_age_days": 30 },
      { "username": "ci-runner", "mfa_enabled": false, "access_key_age_days": 365 }
    ],
    "scp_enforced": false
  },

  "s3": {
    "buckets": [
      { "name": "prod-data-store", "public_acl": false, "versioning": true, "mfa_delete": false, "encryption": true },
      { "name": "static-assets", "public_acl": true, "versioning": false, "mfa_delete": false, "encryption": false },
      { "name": "dev-uploads", "public_acl": true, "versioning": false, "mfa_delete": false, "encryption": false },
      { "name": "backup-store", "public_acl": false, "versioning": true, "mfa_delete": false, "encryption": true },
      { "name": "logs-bucket", "public_acl": false, "versioning": false, "mfa_delete": false, "encryption": true }
    ]
  },

  "ec2": {
    "instances": 12,
    "security_groups_open_ssh": 2,
    "security_groups_open_rdp": 0,
    "default_vpc_exists": true,
    "default_vpc_has_resources": true
  },

  "cloudtrail": {
    "enabled": true,
    "multi_region": false,
    "log_file_validation": true,
    "cloudwatch_integration": false,
    "s3_bucket_public": false
  },

  "vpc": {
    "flow_logs_enabled": false,
    "default_vpc_removed": false
  },

  "rds": {
    "instances": [
      { "id": "prod-db", "engine": "postgres", "encrypted": true, "publicly_accessible": false },
      { "id": "dev-db", "engine": "mysql", "encrypted": false, "publicly_accessible": true }
    ]
  },

  "kms": {
    "cmk_count": 6,
    "rotation_enabled_count": 4
  },

  "monitoring": {
    "guardduty_enabled": false,
    "security_hub_enabled": false,
    "aws_config_enabled": false,
    "macie_enabled": false,
    "inspector_enabled": false
  }
}
